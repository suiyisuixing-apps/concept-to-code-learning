# Optional local fixture storage; default is ignored data/local under this checkout.
# C2C_DATA_DIR=/choose/an/isolated/local/fixture-folder
# No tokens, model downloads, cloud credentials or network search are used by this fixture.
# Sprint 1 integration seams: all shipped adapters are offline fixtures.
DOCUMENT_PROVIDER=fixture
GITHUB_SOURCE_PROVIDER=fixture
TUTOR_PROVIDER=fixture
# TUTOR_BASE_URL and TUTOR_MODEL are required for a future openai_compatible adapter.
# Selecting pptx/github/openai_compatible currently fails explicitly; no fallback.
TUTOR_BASE_URL=
TUTOR_MODEL=
