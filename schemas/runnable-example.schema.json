{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runnable-example",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "enum": [
        "ADAPTED_FROM_SOURCE",
        "AI_GENERATED",
        "GITHUB_SOURCE_VERIFIED",
        "LOCAL_REPOSITORY_VERIFIED"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "VERIFIED_RUNNABLE",
        "NOT_RUN",
        "NEEDS_CONFIRMATION",
        "REJECTED"
      ]
    },
    "command": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "stderr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "executed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "isolation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "example_id",
    "provenance",
    "source_ids",
    "status",
    "command",
    "exit_code",
    "stdout",
    "stderr",
    "executed_at",
    "isolation"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED_RUNNABLE"
          }
        }
      },
      "then": {
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exit_code": {
            "const": 0
          },
          "executed_at": {
            "type": "string",
            "format": "date-time"
          },
          "isolation": {
            "type": "string",
            "minLength": 1
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          }
        }
      }
    }
  ]
}
