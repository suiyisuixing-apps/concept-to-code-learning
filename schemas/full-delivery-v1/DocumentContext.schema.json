{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "block_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Block Id",
          "type": "string"
        },
        "code_license": {
          "anyOf": [
            {
              "$ref": "#/$defs/LicenseObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "code_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_asset_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Asset Id"
        },
        "kind": {
          "enum": [
            "paragraph",
            "table",
            "caption",
            "code",
            "formula",
            "image",
            "unsupported"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "table_rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 1000,
          "title": "Table Rows",
          "type": "array"
        },
        "text": {
          "default": "",
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "kind",
        "source_locator"
      ],
      "title": "Block",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "blob_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Blob Sha",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "file_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "repository": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "repository",
        "commit_sha",
        "file_path",
        "blob_sha",
        "line_start",
        "line_end"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "LicenseFile": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "permalink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permalink"
        }
      },
      "required": [
        "path",
        "content_sha256"
      ],
      "title": "LicenseFile",
      "type": "object"
    },
    "LicenseObservation": {
      "additionalProperties": false,
      "properties": {
        "code_display_allowed": {
          "default": false,
          "title": "Code Display Allowed",
          "type": "boolean"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/LicenseFile"
          },
          "title": "Files",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "enum": [
            "DETECTED",
            "UNKNOWN",
            "MIXED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "LicenseObservation",
      "type": "object"
    },
    "SelectionLocator": {
      "additionalProperties": false,
      "properties": {
        "normalization": {
          "default": "exact",
          "enum": [
            "exact",
            "whitespace-v1"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/SelectionSpan"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "spans"
      ],
      "title": "SelectionLocator",
      "type": "object"
    },
    "SelectionSpan": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Block Id",
          "type": "string"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "SelectionSpan",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Heading Path",
          "type": "array"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "unit_type": {
          "enum": [
            "page",
            "slide",
            "section"
          ],
          "title": "Unit Type",
          "type": "string"
        }
      },
      "required": [
        "unit_type",
        "index"
      ],
      "title": "SourceLocator",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code_license": {
      "anyOf": [
        {
          "$ref": "#/$defs/LicenseObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code_location": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeLocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contract_version": {
      "const": "full-delivery-v1",
      "default": "full-delivery-v1",
      "title": "Contract Version",
      "type": "string"
    },
    "coverage": {
      "enum": [
        "TEXT",
        "PARTIAL",
        "NO_EXTRACTABLE_TEXT"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "document_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "document_revision": {
      "minimum": 1,
      "title": "Document Revision",
      "type": "integer"
    },
    "file_name": {
      "title": "File Name",
      "type": "string"
    },
    "mode": {
      "enum": [
        "LIVE",
        "FIXTURE",
        "UNAVAILABLE"
      ],
      "title": "Mode",
      "type": "string"
    },
    "original_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Original Sha256",
      "type": "string"
    },
    "relevant_context_blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "title": "Relevant Context Blocks",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "selected_text": {
      "default": "",
      "maxLength": 10000,
      "title": "Selected Text",
      "type": "string"
    },
    "selected_text_hash": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Text Hash"
    },
    "selection_locator": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectionLocator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_type": {
      "enum": [
        "PDF",
        "PPTX",
        "DOCX",
        "MARKDOWN",
        "CODE"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "status": {
      "enum": [
        "READY",
        "PARTIAL",
        "NO_EXTRACTABLE_TEXT"
      ],
      "title": "Status",
      "type": "string"
    },
    "unit_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Unit Id",
      "type": "string"
    },
    "unit_locator": {
      "$ref": "#/$defs/SourceLocator"
    },
    "visible_text": {
      "maxLength": 100000,
      "title": "Visible Text",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "document_id",
    "document_revision",
    "original_sha256",
    "source_type",
    "file_name",
    "unit_id",
    "unit_locator",
    "visible_text",
    "relevant_context_blocks",
    "coverage",
    "status"
  ],
  "title": "DocumentContext",
  "type": "object"
}
