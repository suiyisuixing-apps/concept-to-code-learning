{
  "$defs": {
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "blob_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Blob Sha",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "file_path": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "File Path",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "repository": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "repository",
        "commit_sha",
        "file_path",
        "blob_sha",
        "line_start",
        "line_end"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "LicenseFile": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "permalink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permalink"
        }
      },
      "required": [
        "path",
        "content_sha256"
      ],
      "title": "LicenseFile",
      "type": "object"
    },
    "LicenseObservation": {
      "additionalProperties": false,
      "properties": {
        "code_display_allowed": {
          "default": false,
          "title": "Code Display Allowed",
          "type": "boolean"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/LicenseFile"
          },
          "title": "Files",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "enum": [
            "DETECTED",
            "UNKNOWN",
            "MIXED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "LicenseObservation",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "code_license": {
      "anyOf": [
        {
          "$ref": "#/$defs/LicenseObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code_location": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeLocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contract_version": {
      "const": "full-delivery-v1",
      "default": "full-delivery-v1",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Document Id",
      "type": "string"
    },
    "file_name": {
      "maxLength": 240,
      "minLength": 1,
      "title": "File Name",
      "type": "string"
    },
    "import_status": {
      "enum": [
        "READY",
        "PARTIAL",
        "NO_EXTRACTABLE_TEXT",
        "FAILED"
      ],
      "title": "Import Status",
      "type": "string"
    },
    "mode": {
      "enum": [
        "LIVE",
        "FIXTURE",
        "UNAVAILABLE"
      ],
      "title": "Mode",
      "type": "string"
    },
    "original_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Original Sha256",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "source_type": {
      "enum": [
        "PDF",
        "PPTX",
        "DOCX",
        "MARKDOWN",
        "CODE"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "unit_count": {
      "minimum": 0,
      "title": "Unit Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "document_id",
    "file_name",
    "source_type",
    "original_sha256",
    "unit_count",
    "import_status",
    "created_at"
  ],
  "title": "DocumentRecord",
  "type": "object"
}
