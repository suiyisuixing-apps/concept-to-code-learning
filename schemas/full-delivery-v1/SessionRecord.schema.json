{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "block_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Block Id",
          "type": "string"
        },
        "image_asset_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Asset Id"
        },
        "kind": {
          "enum": [
            "paragraph",
            "table",
            "caption",
            "code",
            "formula",
            "image",
            "unsupported"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "table_rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 1000,
          "title": "Table Rows",
          "type": "array"
        },
        "text": {
          "default": "",
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "kind",
        "source_locator"
      ],
      "title": "Block",
      "type": "object"
    },
    "DocumentContext": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "full-delivery-v1",
          "default": "full-delivery-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "TEXT",
            "PARTIAL",
            "NO_EXTRACTABLE_TEXT"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "document_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "document_revision": {
          "minimum": 1,
          "title": "Document Revision",
          "type": "integer"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "mode": {
          "enum": [
            "LIVE",
            "FIXTURE",
            "UNAVAILABLE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "original_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Original Sha256",
          "type": "string"
        },
        "relevant_context_blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Relevant Context Blocks",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "selected_text": {
          "default": "",
          "maxLength": 10000,
          "title": "Selected Text",
          "type": "string"
        },
        "selected_text_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Text Hash"
        },
        "selection_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_type": {
          "enum": [
            "PDF",
            "PPTX",
            "DOCX",
            "MARKDOWN"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "READY",
            "PARTIAL",
            "NO_EXTRACTABLE_TEXT"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Unit Id",
          "type": "string"
        },
        "unit_locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "visible_text": {
          "maxLength": 100000,
          "title": "Visible Text",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "document_id",
        "document_revision",
        "original_sha256",
        "source_type",
        "file_name",
        "unit_id",
        "unit_locator",
        "visible_text",
        "relevant_context_blocks",
        "coverage",
        "status"
      ],
      "title": "DocumentContext",
      "type": "object"
    },
    "SelectionLocator": {
      "additionalProperties": false,
      "properties": {
        "normalization": {
          "default": "exact",
          "enum": [
            "exact",
            "whitespace-v1"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/SelectionSpan"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "spans"
      ],
      "title": "SelectionLocator",
      "type": "object"
    },
    "SelectionSpan": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Block Id",
          "type": "string"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "SelectionSpan",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Heading Path",
          "type": "array"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "unit_type": {
          "enum": [
            "page",
            "slide",
            "section"
          ],
          "title": "Unit Type",
          "type": "string"
        }
      },
      "required": [
        "unit_type",
        "index"
      ],
      "title": "SourceLocator",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context_revision": {
      "minimum": 0,
      "title": "Context Revision",
      "type": "integer"
    },
    "contract_version": {
      "const": "full-delivery-v1",
      "default": "full-delivery-v1",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "explanation_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Explanation Ids",
      "type": "array"
    },
    "mode": {
      "enum": [
        "LIVE",
        "FIXTURE",
        "UNAVAILABLE"
      ],
      "title": "Mode",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "EMPTY",
        "READY"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "session_id",
    "context_revision",
    "status",
    "created_at"
  ],
  "title": "SessionRecord",
  "type": "object"
}
