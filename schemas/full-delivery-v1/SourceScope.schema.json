{
  "$defs": {
    "ScopeLimit": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Files",
          "type": "integer"
        },
        "repositories": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Repositories",
          "type": "integer"
        }
      },
      "title": "ScopeLimit",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_query_terms": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Approved Query Terms",
      "type": "array"
    },
    "auto_public_search": {
      "default": false,
      "title": "Auto Public Search",
      "type": "boolean"
    },
    "language_hint": {
      "anyOf": [
        {
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language Hint"
    },
    "local_handle": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Handle"
    },
    "max_sources": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Sources",
      "type": "integer"
    },
    "network_authorized": {
      "default": false,
      "title": "Network Authorized",
      "type": "boolean"
    },
    "query_terms_approved": {
      "default": false,
      "title": "Query Terms Approved",
      "type": "boolean"
    },
    "repository_allowlist": {
      "items": {
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Repository Allowlist",
      "type": "array"
    },
    "scope_limit": {
      "$ref": "#/$defs/ScopeLimit"
    },
    "source_mode": {
      "default": "specified_public",
      "enum": [
        "specified_public",
        "public_search",
        "local_authorized"
      ],
      "title": "Source Mode",
      "type": "string"
    }
  },
  "title": "SourceScope",
  "type": "object"
}
