          "title": "Contract Version",
          "type": "string"
        },
        "document_citations": {
          "items": {
            "$ref": "#/$defs/DocumentCitation"
          },
          "maxItems": 100,
          "title": "Document Citations",
          "type": "array"
        },
        "example_blocks": {
          "items": {
            "$ref": "#/$defs/ExampleBlock"
          },
          "title": "Example Blocks",
          "type": "array"
        },
        "explanation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Explanation Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "Beginner",
            "University",
            "Engineering",
            "Source-code"
          ],
          "title": "Level",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "mode": {
          "enum": [
            "LIVE",
            "FIXTURE",
            "UNAVAILABLE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "provider_info": {
          "$ref": "#/$defs/ProviderInfo"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "enum": [
            "GROUNDED",
            "NO_VERIFIED_CODE",
            "FIXTURE"
          ],
          "title": "Status",
          "type": "string"
        },
        "unsupported_claims": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Claims",
          "type": "array"
        }
      },
      "required": [
        "mode",
        "explanation_id",
        "question",
        "context_snapshot",
        "level",
        "answer_sections",
        "provider_info",
        "metrics",
        "status"
      ],
      "title": "GroundedExplanation",
      "type": "object"
    },
    "LicenseFile": {
      "additionalProperties": false,
