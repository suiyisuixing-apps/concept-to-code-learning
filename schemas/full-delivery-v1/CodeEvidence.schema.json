{
  "$defs": {
    "LicenseFile": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "permalink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permalink"
        }
      },
      "required": [
        "path",
        "content_sha256"
      ],
      "title": "LicenseFile",
      "type": "object"
    },
    "LicenseObservation": {
      "additionalProperties": false,
      "properties": {
        "code_display_allowed": {
          "default": false,
          "title": "Code Display Allowed",
          "type": "boolean"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/LicenseFile"
          },
          "title": "Files",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "enum": [
            "DETECTED",
            "UNKNOWN",
            "MIXED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "LicenseObservation",
      "type": "object"
    },
    "Relevance": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "items": {
            "type": "string"
          },
          "title": "Basis",
          "type": "array"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "CANDIDATE",
            "UNCERTAIN",
            "NOT_RELEVANT"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "Relevance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code_excerpt": {
      "maxLength": 20000,
      "title": "Code Excerpt",
      "type": "string"
    },
    "commit_sha": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit Sha"
    },
    "contract_version": {
      "const": "full-delivery-v1",
      "default": "full-delivery-v1",
      "title": "Contract Version",
      "type": "string"
    },
    "dirty": {
      "default": false,
      "title": "Dirty",
      "type": "boolean"
    },
    "excerpt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Excerpt Sha256",
      "type": "string"
    },
    "execution_status": {
      "default": "NOT_RUN",
      "enum": [
        "NOT_RUN",
        "RUN_PASSED",
        "RUN_FAILED",
        "BLOCKED"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "file_blob_sha": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Blob Sha"
    },
    "file_path": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "File Path",
      "type": "string"
    },
    "file_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Sha256"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "license_observation": {
      "$ref": "#/$defs/LicenseObservation"
    },
    "line_end": {
      "minimum": 1,
      "title": "Line End",
      "type": "integer"
    },
    "line_start": {
      "minimum": 1,
      "title": "Line Start",
      "type": "integer"
    },
    "local_handle": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Handle"
    },
    "mode": {
      "enum": [
        "LIVE",
        "FIXTURE",
        "UNAVAILABLE"
      ],
      "title": "Mode",
      "type": "string"
    },
    "permalink": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permalink"
    },
    "provenance_kind": {
      "enum": [
        "SOURCE_EXACT",
        "ADAPTED_FROM_SOURCE",
        "AI_GENERATED"
      ],
      "title": "Provenance Kind",
      "type": "string"
    },
    "relevance": {
      "$ref": "#/$defs/Relevance"
    },
    "repository_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Name"
    },
    "repository_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Owner"
    },
    "repository_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Url"
    },
    "requested_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Ref"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "specified_public",
        "public_search",
        "local_authorized"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Symbol"
    },
    "symbol_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Symbol Kind"
    },
    "verification_checks": {
      "additionalProperties": {
        "enum": [
          "PASSED",
          "FAILED",
          "NOT_APPLICABLE",
          "NOT_CHECKED"
        ],
        "type": "string"
      },
      "title": "Verification Checks",
      "type": "object"
    },
    "verification_status": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "NEEDS_CONFIRMATION",
        "REJECTED"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "visibility": {
      "enum": [
        "public",
        "local"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "source_id",
    "source_mode",
    "visibility",
    "file_path",
    "language",
    "line_start",
    "line_end",
    "code_excerpt",
    "excerpt_sha256",
    "license_observation",
    "retrieved_at",
    "verification_checks",
    "provenance_kind",
    "verification_status",
    "relevance"
  ],
  "title": "CodeEvidence",
  "type": "object"
}
