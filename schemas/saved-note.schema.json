                    },
                    "symbol_type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line_start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "line_end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "excerpt_hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "license_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "license_url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "retrieved_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "verification_method": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_status": {
                      "const": "GITHUB_SOURCE_VERIFIED"
                    }
                  }
                }
              }
            ]
          }
        },
        "code_comparison": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_ids": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "AI_GENERATED",
                  "NEEDS_CONFIRMATION"
                ]
              }
            },
            "required": [
              "source_ids",
              "explanation",
              "status"
            ]
          }
        },
        "runnable_example_status": {
          "enum": [
            "VERIFIED_RUNNABLE",
            "NOT_RUN",
            "NEEDS_CONFIRMATION",
            "REJECTED"
          ]
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "grounded_explanation_id",
        "mode",
        "status",
        "question",
        "document_context",
        "concept",
        "explanation_level",
        "explanation",
        "document_citations",
        "github_sources",
        "code_comparison",
        "runnable_example_status",
        "unresolved_items"
      ]
    },
    "mode": {
      "const": "FIXTURE"
    },
    "status": {
      "const": "SCAFFOLD_DEMO"
    }
  },
  "required": [
    "note_id",
    "title",
    "user_text",
    "grounded_explanation_id",
    "document_sources",
    "github_sources",
    "created_at",
    "updated_at",
